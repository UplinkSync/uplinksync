{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "page", "color": "#f3f6fa", "name": "Page (Daylight background)" },
				{ "slug": "surface", "color": "#ffffff", "name": "Surface (cards, panels)" },
				{ "slug": "surface-sunken", "color": "#eaeef4", "name": "Surface sunken (inputs, wells)" },
				{ "slug": "surface-tint", "color": "#e2eeff", "name": "Surface tint (info strips, hover rows)" },
				{ "slug": "line", "color": "#dbe2eb", "name": "Line (decorative hairlines)" },
				{ "slug": "line-strong", "color": "#77879f", "name": "Line strong (input and button outlines)" },
				{ "slug": "ink", "color": "#173258", "name": "Ink (text on light)" },
				{ "slug": "ink-muted", "color": "#46628a", "name": "Ink muted (secondary text on light)" },
				{ "slug": "nav", "color": "#173258", "name": "Nav (logo navy header)" },
				{ "slug": "hero", "color": "#173258", "name": "Hero (One Navy band)" },
				{ "slug": "navy-800", "color": "#20406c", "name": "Navy 800 (hero lift, active nav)" },
				{ "slug": "navy-950", "color": "#0a1f3c", "name": "Navy 950 (footer)" },
				{ "slug": "on-dark", "color": "#fbfbfb", "name": "On dark (text on navy)" },
				{ "slug": "on-dark-muted", "color": "#b2c6e2", "name": "On dark muted (secondary text on navy)" },
				{ "slug": "accent", "color": "#0c5fc1", "name": "Accent (links, primary buttons on light)" },
				{ "slug": "accent-hover", "color": "#00499c", "name": "Accent hover" },
				{ "slug": "on-accent", "color": "#ffffff", "name": "On accent (text on accent fill)" },
				{ "slug": "accent-on-dark", "color": "#7db3ff", "name": "Accent on dark (links, buttons on navy)" },
				{ "slug": "accent-on-dark-hover", "color": "#a4caff", "name": "Accent on dark hover" },
				{ "slug": "on-accent-dark", "color": "#0a1f3c", "name": "On accent dark (text on accent-on-dark fill)" },
				{ "slug": "teal", "color": "#93d1e8", "name": "Teal (signature only: focus on dark, heading rule, active nav)" },
				{ "slug": "brand-blue", "color": "#579af6", "name": "Brand blue (logo and large shapes on navy only)" },
				{ "slug": "success", "color": "#0b7643", "name": "Success (always with icon and word)" },
				{ "slug": "warning", "color": "#885700", "name": "Warning (always with icon and word)" },
				{ "slug": "danger", "color": "#ba2b2e", "name": "Danger (always with icon and word)" },
				{ "slug": "info", "color": "#0c5fc1", "name": "Info (always with icon and word)" },

				{ "slug": "navy-900", "color": "#173258", "name": "Legacy alias: Navy 900 -> nav" },
				{ "slug": "navy-700", "color": "#20406c", "name": "Legacy alias: Navy 700 -> navy-800" },
				{ "slug": "navy-850", "color": "#0a1f3c", "name": "Legacy alias: Navy 850 -> navy-950" },
				{ "slug": "navy-border", "color": "#46628a", "name": "Legacy alias: Navy border -> ink-muted (hairline on navy)" },
				{ "slug": "grey-250", "color": "#dbe2eb", "name": "Legacy alias: Grey 250 -> line" },
				{ "slug": "accent-500", "color": "#579af6", "name": "Legacy alias: Accent 500 -> brand-blue" },
				{ "slug": "accent-600", "color": "#0c5fc1", "name": "Legacy alias: Accent 600 -> accent" },
				{ "slug": "accent-teal", "color": "#93d1e8", "name": "Legacy alias: Accent Teal -> teal" },
				{ "slug": "grey-50", "color": "#f3f6fa", "name": "Legacy alias: Grey 50 -> page" },
				{ "slug": "grey-200", "color": "#dbe2eb", "name": "Legacy alias: Grey 200 -> line" },
				{ "slug": "grey-600", "color": "#46628a", "name": "Legacy alias: Grey 600 -> ink-muted" },
				{ "slug": "black", "color": "#0a1f3c", "name": "Legacy alias: Black -> navy-950" },
				{ "slug": "white", "color": "#ffffff", "name": "Legacy alias: White -> surface" },
				{ "slug": "dark", "color": "#173258", "name": "Legacy alias: Dark -> ink" },
				{ "slug": "light", "color": "#ffffff", "name": "Legacy alias: Light -> surface" },
				{ "slug": "color1", "color": "#f3f6fa", "name": "Legacy alias: Color 1 -> page" },
				{ "slug": "color2", "color": "#173258", "name": "Legacy alias: Color 2 -> nav" },
				{ "slug": "color3", "color": "#0c5fc1", "name": "Legacy alias: Color 3 -> accent" },
				{ "slug": "contrast", "color": "#173258", "name": "Legacy alias: Contrast -> ink" },
				{ "slug": "base", "color": "#ffffff", "name": "Legacy alias: Base (parent theme) -> surface" },
				{ "slug": "secondary", "color": "#dbe2eb", "name": "Legacy alias: Secondary (separator) -> line" },
				{ "slug": "grey", "color": "#77879f", "name": "Legacy alias: Grey (form borders) -> line-strong" }
			],
			"gradients": [
				{
					"slug": "navy-wash",
					"gradient": "linear-gradient(180deg, #173258 0%, #20406c 100%)",
					"name": "Navy wash (legacy alias, same-hue lift)"
				},
				{
					"slug": "hero-lift",
					"gradient": "radial-gradient(120% 140% at 85% 0%, #20406c 0%, rgba(32, 64, 108, 0) 55%), #173258",
					"name": "Hero lift (One Navy with a soft navy-800 corner)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "Tiny", "size": "10px", "slug": "20" },
				{ "name": "X-Small", "size": "20px", "slug": "30" },
				{ "name": "Small", "size": "30px", "slug": "40" },
				{ "name": "Regular", "size": "clamp(30px, 5vw, 50px)", "slug": "50" },
				{ "name": "Large", "size": "clamp(30px, 7vw, 70px)", "slug": "60" },
				{ "name": "X-Large", "size": "clamp(50px, 7vw, 90px)", "slug": "70" },
				{ "name": "XX-Large", "size": "clamp(70px, 10vw, 140px)", "slug": "80" },
				{ "name": "Step 1 (8px)", "size": "0.5rem", "slug": "step-1" },
				{ "name": "Step 2 (16px)", "size": "1rem", "slug": "step-2" },
				{ "name": "Step 3 (24px)", "size": "1.5rem", "slug": "step-3" },
				{ "name": "Step 4 (32px)", "size": "2rem", "slug": "step-4" },
				{ "name": "Step 5 (48px)", "size": "3rem", "slug": "step-5" },
				{ "name": "Step 6 (64-96px section)", "size": "clamp(4rem, 3.2rem + 3.2vw, 6rem)", "slug": "step-6" },
				{ "name": "Step 7 (72-104px hero)", "size": "clamp(4.5rem, 3.85rem + 2.6vw, 6.5rem)", "slug": "step-7" }
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw", "ch" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "DM Sans",
					"slug": "dmsans",
					"fontFamily": "DMSans, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "DMSans", "fontWeight": "100 1000", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/DMSans-latin-var.woff2" ] },
						{ "fontFamily": "DMSans", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/DMSans-Italic.woff2" ] },
						{ "fontFamily": "DMSans", "fontWeight": "500", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/DMSans-MediumItalic.woff2" ] },
						{ "fontFamily": "DMSans", "fontWeight": "700", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/DMSans-BoldItalic.woff2" ] }
					]
				},
				{
					"name": "Quicksand",
					"slug": "quicksand",
					"fontFamily": "Quicksand, DMSans, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Quicksand", "fontWeight": "300 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Quicksand-latin-var.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "name": "Small", "slug": "small", "size": "0.875rem", "fluid": false },
				{ "name": "Medium (body)", "slug": "medium", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "name": "Large", "slug": "large", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "name": "Extra Large", "slug": "x-large", "size": "2rem", "fluid": { "min": "1.75rem", "max": "2rem" } },
				{ "name": "Extra Extra Large", "slug": "xx-large", "size": "3rem", "fluid": { "min": "2.15rem", "max": "3rem" } },
				{ "name": "H2", "slug": "h2", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "name": "H1", "slug": "h1", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|page",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|dmsans",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|ink" },
				"typography": {
					"fontFamily": "var:preset|font-family|quicksand",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "0"
				}
			},
			"h1": {
				"typography": { "fontSize": "var:preset|font-size|h1", "lineHeight": "1.08" }
			},
			"h2": {
				"typography": { "fontSize": "var:preset|font-size|h2", "lineHeight": "1.2" }
			},
			"h3": {
				"typography": { "fontSize": "clamp(1.25rem, 1.13rem + 0.49vw, 1.5rem)", "lineHeight": "1.3" }
			},
			"h4": {
				"typography": { "fontSize": "clamp(1.125rem, 1.065rem + 0.25vw, 1.25rem)", "fontWeight": "600", "lineHeight": "1.35" }
			},
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|accent-hover" },
					"typography": { "textDecoration": "underline" }
				},
				":focus-visible": {
					"outline": { "color": "var:preset|color|accent", "offset": "2px", "style": "solid", "width": "2px" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|on-accent"
				},
				"border": { "radius": "10px", "width": "2px", "style": "solid", "color": "transparent" },
				"spacing": {
					"padding": { "top": "0.625rem", "bottom": "0.625rem", "left": "1.5rem", "right": "1.5rem" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|dmsans",
					"fontSize": "1rem",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-hover",
						"text": "var:preset|color|on-accent"
					},
					"border": { "color": "transparent" }
				},
				":focus-visible": {
					"outline": { "color": "var:preset|color|accent", "offset": "2px", "style": "solid", "width": "2px" }
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "no-title", "title": "No Title (hero-led page)", "postTypes": [ "page" ] }
	]
}
