{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "navy-900", "color": "#173258", "name": "Navy 900 (primary dark)" },
				{ "slug": "navy-700", "color": "#1F4375", "name": "Navy 700 (secondary dark surface)" },
				{ "slug": "accent-500", "color": "#5697F3", "name": "Accent 500 (primary accent)" },
				{ "slug": "accent-600", "color": "#2F6FC4", "name": "Accent 600 (interactive fill, WCAG AA with white text)" },
				{ "slug": "accent-teal", "color": "#95D5DD", "name": "Accent Teal (secondary accent)" },
				{ "slug": "grey-50", "color": "#F7F9FB", "name": "Grey 50 (page background)" },
				{ "slug": "grey-200", "color": "#E3E8ED", "name": "Grey 200 (borders/dividers)" },
				{ "slug": "grey-600", "color": "#5B6672", "name": "Grey 600 (secondary text)" },
				{ "slug": "black", "color": "#0A0A0A", "name": "Black (high-contrast text)" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },

				{ "slug": "dark",    "color": "#0d141a", "name": "***-192 compat: Dark (text on light)" },
				{ "slug": "light",   "color": "#ffffff", "name": "Light (compat: light surface / text on dark)" },
				{ "slug": "color1",  "color": "#f4f5f8", "name": "Color 1 (compat: light section background)" },
				{ "slug": "color2",  "color": "#1e3155", "name": "Color 2 (compat: dark section background)" },
				{ "slug": "color3",  "color": "#4673c6", "name": "Color 3 (compat: accent)" },
				{ "slug": "contrast","color": "#0d141a", "name": "Contrast (compat: masked by brand-blocks button rule)" },
				{ "slug": "grey",    "color": "#B8C0CC", "name": "Grey (compat: form borders)" }
			],
			"gradients": [
				{
					"slug": "navy-wash",
					"gradient": "linear-gradient(180deg, #173258 0%, #1F4375 100%)",
					"name": "Navy wash (dark section background)"
				}
			]
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
